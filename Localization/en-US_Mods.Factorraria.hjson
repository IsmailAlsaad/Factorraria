Items: {
	ClosedScrollItem: {
		DisplayName: Sealed Scroll
		Tooltip: Right click to break the seal and receive a recipe parchment
	}

	RecipeParchmentItem: {
		DisplayName: Recipe Parchment
		Tooltip: Right click to read it and learn a machine recipe
	}

	CopperWireItem: {
		DisplayName: Copper Wire
		Tooltip:
			'''
			Can be placed
			Used to transmit power to machines
			Right click to connect power poles together
			'''
	}

	TinWireItem: {
		DisplayName: Tin Wire
		Tooltip:
			'''
			Can be placed
			Used to transmit power to machines
			Right click to connect power poles together
			'''
	}

	ClockwisePriorityConveyor: {
		DisplayName: Priority Conveyor Belt (Clockwise)
		Tooltip:
			'''
			Right click on the conveyor tile while holding an item to set a filter
			Shift + Right click in inventory to swap direction
			'''
